#!/bin/sh
# keys — one-screen cheat sheet for the desktop (sway + keyd): six small
# key/action tables, two per band, 80 columns wide. Hand-written on purpose:
# a parser cannot know that hjkl needs no explaining. Keep in step with
# wm-linux/.config/sway/config and the keyd block in modules/nixos/desktop.nix.
# Colors: everforest (same as the bar); off when piped.
if [ -t 1 ]; then
  Y=$(printf '\033[1;38;2;219;188;127m') # title       — yellow, bold
  K=$(printf '\033[1;38;2;167;192;128m') # key         — green, bold
  D=$(printf '\033[38;2;133;146;137m')   # rule, note  — grey
  R=$(printf '\033[0m')
else
  Y= K= D= R=
fi

# Cells (1-based): left key 3-21, left action 22-39, right key 42-54, right
# action 55-80. A note sits two cells in under its table, grey. printf pads
# by BYTE, so the line with the CJK key spells its padding out instead.
row() { printf "  ${K}%-19s${R}%-18s  ${K}%-13s${R}%s\n" "$@"; }
note() { printf "    ${D}%-35s${R}  ${K}%-13s${R}%s\n" "$@"; }
rule() { while [ "$1" -gt 0 ]; do printf '─'; set -- $(($1 - 1)); done; }
hdr() {
  printf "  ${Y}%s${R} ${D}%s${R}  ${Y}%s${R} ${D}%s${R}\n" \
    "$1" "$(rule $((36 - ${#1})))" "$2" "$(rule $((38 - ${#2})))"
}

printf '\n'
hdr "Remaps" "Screenshots"
row "mod"                "Space held / Win"   "Print"        "region (drag)"
printf "  ${K}%-19s${R}かな held (JIS)     ${K}%-13s${R}%s\n" \
    "mod+Shift"                               "Shift+Print"  "focused window"
row ""                   ""                   "mod+Print"    "whole screen"
printf "    ${D}%-35s${R}    ${D}%s${R}\n" \
    "Steam games: plain Space, mod = Win"        "→ ~/Pictures/screenshots + clipboard"
printf '\n'
hdr "Windows" "Layout"
row "mod+Return"         "foot"               "mod+b"        "split horizontal"
row "mod+d"              "launcher"           "mod+v"        "split vertical"
row "mod+Shift+q"        "kill window"        "mod+s"        "layout stacking"
row "mod+h/j/k/l"        "focus"              "mod+w"        "layout tabbed"
row "mod+Shift+h/j/k/l"  "move window"        "mod+e"        "layout toggle split"
row "mod+f"              "fullscreen toggle"  "mod+r"        "resize mode: h/j/k/l"
row "mod+space"          "focus float/tiled"  ""             "Return/Esc leaves"
row "mod+Shift+space"    "floating toggle"    "mod+drag"     "move, right-drag resizes"
row "mod+a / +Shift+a"   "focus parent/child" ""             "new window lands beside group"
printf '\n'
hdr "Workspaces" "System"
row "mod+1..4"           "go to workspace"    "mod+Shift+s"  "suspend"
row "mod+Shift+1..4"     "move window there"  "mod+Shift+c"  "sway reload"
note "1:web 2:term 3:game 4:chat"             "mod+Shift+r"  "sway reload (no restart)"
note "same key again goes back"               "mod+Shift+e"  "sway exit"
note "pavucontrol: popup ws 'audio', leaving" ""             ""
note "it closes pavu, closing pavu goes back" ""             ""
row ""                   ""                   "mod+Shift+m"  "monitor menu (Esc leaves):"
row ""                   ""                   ""             "[m]irror [g]ame [d]ual"
row ""                   ""                   ""             "[a]oc [s]peaker [c]ursor"
printf '\n'
