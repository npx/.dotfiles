# i3 config — gaming desktop; deliberately NOT the aerospace layout
# (wm/.aerospace.toml is the work setup — this machine gets its own 5 workspaces).
# Plain dotfile, stow-linked out-of-store: edits apply on $mod+Shift+c reload,
# no nix rebuild. Installed by services.xserver.windowManager.i3
# (modules/nixos/desktop.nix); configFile stays null so this file is read live.

set $mod Mod4

font pango:FiraCode Nerd Font 10

# xterm styling (fonts + colors) lives in ~/.Xresources; ~/.Xresources.local
# is machine-local and untracked (like term/.secrets) — e.g. Xft.dpi: 192 on
# the retina macbook, which must not leak to the desktop
exec_always --no-startup-id sh -c 'xrdb -merge ~/.Xresources; [ -f ~/.Xresources.local ] && xrdb -merge ~/.Xresources.local'

# i3 reads Xft.dpi/Xcursor.size ONCE at startup — before the async merge above
# lands, so the first render is 96dpi. One restart after an ordered merge fixes
# it; `exec` (unlike exec_always) does not re-fire on restart, so no loop.
# No-op where ~/.Xresources.local is absent (the desktop).
exec --no-startup-id sh -c '[ -f ~/.Xresources.local ] && { xrdb -merge ~/.Xresources; xrdb -merge ~/.Xresources.local; i3-msg restart; }'

# key remaps (caps->ctrl, rctrl->;:, ralt->'") — resets on keyboard hotplug,
# $mod+Shift+c re-applies
exec_always --no-startup-id xmodmap ~/.Xmodmap

# desktop monitors: mirror both on start, then pick a layout by hand
# ($mod+Shift+m, mode "monitor" below). `exec`, not exec_always: a restart
# must not throw away the layout that was picked. No-op on the macbook.
exec --no-startup-id ~/.bin/monitor-layout mirror

# drag floating windows with $mod
floating_modifier $mod

bindsym $mod+Return exec xterm
bindsym $mod+d exec dmenu_run
bindsym $mod+Shift+q kill

# vim-style focus/move (aerospace muscle memory)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# layout
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# gaps + thin borders (native gaps, i3 >= 4.22); titlebars only in stacking/tabbed
gaps inner 8
smart_gaps on
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

set $ws1 "1:web"
set $ws2 "2:term"
set $ws3 "3:game"
set $ws4 "4:chat"
set $ws5 "5:misc"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5

# same-workspace keypress bounces back (aerospace --auto-back-and-forth)
workspace_auto_back_and_forth yes

# games hold a pointer grab and re-centre the cursor every frame; with
# focus-follows-mouse that motion yanks focus back to the game the moment
# $mod+N shows a workspace on the other monitor. Keys/clicks focus only.
focus_follows_mouse no

# xterm stays unassigned on purpose — terminal wanted everywhere
assign [class="(?i)^google-chrome$"] $ws1
assign [class="(?i)^steam$"] $ws3
assign [class="(?i)^discord$"] $ws4

# macbook media keys (hid_apple fnmode default: F-row emits these, fn = F1-F12).
# Desktop keyboard never fires them; brightnessctl/playerctl are macbook-only
# packages (hosts/macbook), wpctl ships with pipewire everywhere.
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +10%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-
bindsym XF86KbdBrightnessUp exec --no-startup-id brightnessctl --device='smc::kbd_backlight' set +10%
bindsym XF86KbdBrightnessDown exec --no-startup-id brightnessctl --device='smc::kbd_backlight' set 10%-
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# step away: full suspend — jellyfin is down until a key press wakes the box
bindsym $mod+Shift+s exec --no-startup-id systemctl suspend

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec i3-msg exit

mode "resize" {
  bindsym h resize shrink width 10 px or 10 ppt
  bindsym j resize grow height 10 px or 10 ppt
  bindsym k resize shrink height 10 px or 10 ppt
  bindsym l resize grow width 10 px or 10 ppt
  bindsym Return mode "default"
  bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# desktop monitor layouts (term/.bin/monitor-layout): which machine a monitor
# shows is set at its input button; this only picks what the desktop outputs
#   m  mirror — both, same picture (start default; also "guest + work")
#   g  game   — everything on the iiyama, primary (macbook has the AOC)
#   d  dual   — AOC primary, iiyama above with web + chat
#   a  aoc    — everything on the AOC, primary (guest on the iiyama's HDMI)
#   c  cursor — pointer back onto the visible monitor (outputs stay on, so
#               it can slide onto the dark one; the script warps via i3)
# The mode name is the cheat sheet: i3bar shows it while the mode is active.
# The active layout shows permanently in the bar (i3status read_file).
set $monitor_mode "monitor: [m]irror  [g]ame  [d]ual  [a]oc  [c]ursor  (esc)"
mode $monitor_mode {
  bindsym m exec --no-startup-id ~/.bin/monitor-layout mirror; mode "default"
  bindsym g exec --no-startup-id ~/.bin/monitor-layout game; mode "default"
  bindsym d exec --no-startup-id ~/.bin/monitor-layout dual; mode "default"
  bindsym a exec --no-startup-id ~/.bin/monitor-layout aoc; mode "default"
  bindsym c exec --no-startup-id ~/.bin/monitor-layout cursor; mode "default"
  bindsym Return mode "default"
  bindsym Escape mode "default"
}
bindsym $mod+Shift+m mode $monitor_mode

# everforest dark-medium — WM only; xterm palette stays alacritty-default (see ~/.Xresources)
set $bg     #2d353b
set $bg1    #343f44
set $bg3    #475258
set $fg     #d3c6aa
set $grey   #859289
set $green  #a7c080
set $red    #e67e80
set $yellow #dbbc7f
set $aqua   #83c092

# class                 border bg     text  indicator child_border
client.focused          $green $green $bg   $yellow $green
client.focused_inactive $bg3   $bg3   $grey $bg3   $bg3
client.unfocused        $bg1   $bg1   $grey $bg1   $bg1
client.urgent           $red   $red   $bg   $red   $red

bar {
  position top
  status_command i3status
  font pango:FiraCode Nerd Font 10
  colors {
    background $bg
    statusline $fg
    separator  $grey
    focused_workspace  $green $green $bg
    active_workspace   $bg3   $bg3   $fg
    inactive_workspace $bg    $bg    $grey
    urgent_workspace   $red   $red   $bg
  }
}
