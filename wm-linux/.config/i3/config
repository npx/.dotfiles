# i3 config — gaming desktop; deliberately NOT the aerospace layout
# (wm/.aerospace.toml is the work setup — this machine gets its own 5 workspaces).
# Plain dotfile, stow-linked out-of-store: edits apply on $mod+Shift+c reload,
# no nix rebuild. Installed by services.xserver.windowManager.i3
# (modules/nixos/desktop.nix); configFile stays null so this file is read live.

set $mod Mod4

font pango:FiraCode Nerd Font 10

# xterm styling (fonts + colors) lives in ~/.Xresources
exec_always --no-startup-id xrdb -merge ~/.Xresources

# key remaps (caps->ctrl, space = $mod while held) are keyd, nix-level
# (modules/nixos/desktop.nix). Games need a real held space: the mapper
# swaps it back per focused window (~/.config/keyd/app.conf).
# `exec`: -d forks a daemon that outlives restarts, app.lock stops a second one.
exec --no-startup-id keyd-application-mapper -d

# japanese input (fcitx5 + mozc, nix-level in modules/nixos/desktop.nix;
# keys in ~/.config/fcitx5/config). -d daemonizes, a second start is a no-op.
exec --no-startup-id fcitx5 -d

# desktop monitors: on start the layout follows the monitors' input sources
# (read over DDC), later picked by hand ($mod+Shift+m, mode "monitor"
# below). `exec`, not exec_always: a restart must not redo the layout that
# was picked. No-op on the macbook.
exec --no-startup-id ~/.bin/monitor-layout auto

# drag floating windows with $mod
floating_modifier $mod

bindsym $mod+Return exec xterm
bindsym $mod+d exec dmenu_run
bindsym $mod+Shift+q kill

# vim-style focus/move (aerospace muscle memory)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# layout
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+a focus parent
bindsym $mod+Shift+a focus child
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# gaps + thin borders (native gaps, i3 >= 4.22); titlebars only in stacking/tabbed
gaps inner 8
smart_gaps on
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

set $ws1 "1:web"
set $ws2 "2:term"
set $ws3 "3:game"
set $ws4 "4:chat"
set $ws5 "5:misc"

# workspace -> output pins for the current monitor layout, written by
# term/.bin/monitor-layout (reloads i3). Runtime dir: gone on reboot, and the
# mirror exec on start writes it again. Skipped by i3 while it does not exist
# (first start, macbook).
include $XDG_RUNTIME_DIR/monitor-layout.conf

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5

# same-workspace keypress bounces back (aerospace --auto-back-and-forth)
workspace_auto_back_and_forth yes

# games hold a pointer grab and re-centre the cursor every frame; with
# focus-follows-mouse that motion yanks focus back to the game the moment
# $mod+N shows a workspace on the other monitor. Keys/clicks focus only.
focus_follows_mouse no

# xterm stays unassigned on purpose — terminal wanted everywhere
assign [class="(?i)^google-chrome$"] $ws1
assign [class="(?i)^steam$"] $ws3
assign [class="(?i)^discord$"] $ws4
assign [class="(?i)^pavucontrol$"] $ws5

# step away: full suspend — jellyfin is down until a key press wakes the box
bindsym $mod+Shift+s exec --no-startup-id systemctl suspend

# audio (media keys): wpctl = wireplumber; acts on pipewire's current
# default sink (pavucontrol on ws5 picks it).
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# screenshots (maim, modules/home/linux.nix): Print = drag a region,
# Shift+Print = focused window, $mod+Print = whole screen. Each lands in
# ~/Pictures/screenshots and on the clipboard.
set $shot exec --no-startup-id mkdir -p ~/Pictures/screenshots && f=~/Pictures/screenshots/$(date +%Y-%m-%d_%H-%M-%S).png && maim
set $shot_clip | tee "$f" | xclip -selection clipboard -t image/png
bindsym Print $shot -s -u $shot_clip
bindsym Shift+Print $shot -u -i $(xdotool getactivewindow) $shot_clip
bindsym $mod+Print $shot -u $shot_clip

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec i3-msg exit

mode "resize" {
  bindsym h resize shrink width 10 px or 10 ppt
  bindsym j resize grow height 10 px or 10 ppt
  bindsym k resize shrink height 10 px or 10 ppt
  bindsym l resize grow width 10 px or 10 ppt
  bindsym Return mode "default"
  bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# desktop monitor layouts (term/.bin/monitor-layout): a layout is which
# machine each monitor shows — the script switches the monitors' inputs
# over DDC and lays out the desktop's outputs to match
#   m  mirror — both, same picture; inputs untouched ("guest + work")
#   g  game   — iiyama to the desktop, primary, everything; AOC to the macbook
#   d  dual   — both to the desktop: AOC primary (game), iiyama above with the rest
#   a  aoc    — AOC to the desktop, primary, everything; iiyama to the guest
#   s  speaker — in aoc: iiyama's input DP <-> HDMI, layout untouched (its
#               speakers play only the input it shows; DP is the desktop)
#   c  cursor — pointer back onto the visible monitor (the outputs sit
#               diagonally, it cannot slide across — but focus can still
#               leave it on the dark one; the script warps via i3)
# Opening the menu already reads the inputs (probe), so the pick is instant
# and only writes an input that actually changes (a rewrite blanks briefly).
# Existing workspaces are moved; new ones follow the `include`d pins above.
# The mode name is the cheat sheet: i3bar shows it while the mode is active.
# The active layout shows permanently in the bar (i3status read_file).
set $monitor_mode "monitor: [m]irror  [g]ame  [d]ual  [a]oc  [s]peaker  [c]ursor  (esc)"
mode $monitor_mode {
  bindsym m exec --no-startup-id ~/.bin/monitor-layout mirror; mode "default"
  bindsym g exec --no-startup-id ~/.bin/monitor-layout game; mode "default"
  bindsym d exec --no-startup-id ~/.bin/monitor-layout dual; mode "default"
  bindsym a exec --no-startup-id ~/.bin/monitor-layout aoc; mode "default"
  bindsym s exec --no-startup-id ~/.bin/monitor-layout speaker; mode "default"
  bindsym c exec --no-startup-id ~/.bin/monitor-layout cursor; mode "default"
  bindsym Return mode "default"
  bindsym Escape mode "default"
}
bindsym $mod+Shift+m exec --no-startup-id ~/.bin/monitor-layout probe; mode $monitor_mode

# everforest dark-medium — WM only; xterm palette stays alacritty-default (see ~/.Xresources)
set $bg     #2d353b
set $bg1    #343f44
set $bg3    #475258
set $fg     #d3c6aa
set $grey   #859289
set $green  #a7c080
set $red    #e67e80
set $yellow #dbbc7f
set $orange #e69875
set $aqua   #83c092

# indicator (orange) is only drawn on a window that is ALONE in its split container
# class                 border bg     text  indicator child_border
client.focused          $green $green $bg   $orange $green
client.focused_inactive $bg3   $bg3   $grey $bg3   $bg3
client.unfocused        $bg1   $bg1   $grey $bg1   $bg1
client.urgent           $red   $red   $bg   $red   $red

bar {
  position top
  status_command i3status
  font pango:FiraCode Nerd Font 10
  colors {
    background $bg
    statusline $fg
    separator  $grey
    focused_workspace  $green $green $bg
    active_workspace   $bg3   $bg3   $fg
    inactive_workspace $bg    $bg    $grey
    urgent_workspace   $red   $red   $bg
  }
}
