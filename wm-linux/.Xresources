! xterm — mirrors the alacritty look. term/.alacritty.toml defines NO colors,
! so below is the alacritty built-in default dark palette, hardcoded once.
! If alacritty ever gets explicit colors, copy the hex values here — that is
! the whole sync mechanism, on purpose.
! Loaded by i3 via exec_always xrdb -merge.
! NOTE: xrdb runs this file through cpp — no apostrophes in comments!

XTerm*termName: xterm-256color
XTerm*utf8: 1
XTerm*faceName: FiraCode Nerd Font Mono
XTerm*faceSize: 12
XTerm*internalBorder: 5

! select-to-clipboard so mouse selection lands where tmux/xclip/nvim expect it
XTerm*selectToClipboard: true

XTerm*background: #181818
XTerm*foreground: #d8d8d8
XTerm*cursorColor: #d8d8d8

! normal
XTerm*color0: #181818
XTerm*color1: #ac4242
XTerm*color2: #90a959
XTerm*color3: #f4bf75
XTerm*color4: #6a9fb5
XTerm*color5: #aa759f
XTerm*color6: #75b5aa
XTerm*color7: #d8d8d8
! bright
XTerm*color8: #6b6b6b
XTerm*color9: #c55555
XTerm*color10: #aac474
XTerm*color11: #feca88
XTerm*color12: #82b8c8
XTerm*color13: #c28cb8
XTerm*color14: #93d3c3
XTerm*color15: #f8f8f8
